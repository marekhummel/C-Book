<!-- DETAILED APPOINTMENT -->

<!-- Local variable -->
<% id = @appointment["ID"] %>
 
<!-- Overview -->

  
<div class="container detail">
	<p><%= "Ereignis: " + @appointment["Title"].to_s %></p>

	<!-- Timespan -->
	<span style="margin-right: 10px;"><u>Dauer:</u></span>
	<span><%= DateTime.iso8601(@appointment["Start"]).Format! %></span>
	<span style="margin: 0px 8px;">-</span>
	<span><%= DateTime.iso8601(@appointment["End"]).Format! %></span><br><br>

	<!-- Contributors -->
	<span>
	    <u style="margin-right: 5px;"><%= "Teilnehmer:" %></u> 	
	    <% for cont in @contributors %>
	        <span style="font-size: 12px;"><%= get_fullname(cont) + ";" %> </span>
	    <% end %>
	</span>


	<% if @user_is_creator %>
		<br><br><br><span>U ARE THE CREATOR</span>
	<% end %>

	<!-- Delete button -->
	<% if @user_is_creator %>
		<form action="/appointment_delete" method="post">
		    <input type="hidden" name="id" value=<%= id.to_s %> />
		    <input type="hidden" name="_method" value="delete">
		    <button style="float: left;" type="submit">Löschen</button>
		</form>
	<% end %>

	<!-- Edit button -->
	<% if @user_is_creator %>
		<form action=<%= "/appointment/" + id.to_s + "/edit" %> method="get">
		    <button style="float: right;" type="submit">Bearbeiten</button>
		</form>	
	<% end %>


	<!-- Remove the user as contributor -->
	<% if !@user_is_creator %>
		<form action=<%= "/appointment_unsubscribe" %> method="post">
			<input type="hidden" name="id" value=<%= id.to_s %> />
			<input type="hidden" name="_method" value="delete">
		    <button style="float: right;" type="submit">Nicht weiter teilnehmen</button>
		</form>	
	<% end %>
</div>



<!-- DETAILED APPOINTMENT -->

<!-- Local variable -->
<% id = @appointment["ID"] %>
 
<!-- Overview -->

  
<div class="container detail">
	<p><%= @appointment["Title"].to_s %></p>

	<!-- Timespan -->
	<span style="margin-right: 10px;"><u>Dauer:</u></span>
	<% starttime = DateTime.iso8601(@appointment["Start"]) %>
	<% endtime = DateTime.iso8601(@appointment["End"]) %>
	<span><%= format_duration_datetimes(starttime, endtime) %></span><br><br>


	<!-- Creator -->
	<span>
	    <u style="margin-right: 5px;"><%= "Ersteller:" %></u> 	
	    <span style="font-size: 12px;"><%= get_fullname(@creator, true) %> </span><br>
	</span>


	<!-- Contributors -->
	<span>
	    <u style="margin-right: 5px;"><%= "Teilnehmer:" %></u> 
	    <% if @contributors.size > 0 %>	
		    <% for cont in @contributors %>
		        <span style="font-size: 12px;"><%= get_fullname(cont, true) + ";" %> </span>
		    <% end %>
		<% else %>
			<span style="font-size: 12px;">-----</span>
	    <% end %>
	</span>



	<!-- Delete button -->
	<% if @user_is_creator %>
		<form action="/appointment_delete" method="post" onsubmit="return validateDelete()">
		    <input type="hidden" name="id" value=<%= id.to_s %> />
		    <input type="hidden" name="_method" value="delete">
		    <button style="float: left;" type="submit">Löschen</button>
		</form>
	<% end %>

	<!-- Edit button -->
	<% if @user_is_creator %>
		<form action=<%= "/appointment/" + id.to_s + "/edit" %> method="get">
		    <button style="float: right;" type="submit">Bearbeiten</button>
		</form>	
	<% end %>


	<!-- Remove the user as contributor -->
	<% if !@user_is_creator %>
		<form action=<%= "/appointment_unsubscribe" %> method="post" onsubmit="return validateUnsubscribe()">
			<input type="hidden" name="id" value=<%= id.to_s %> />
			<input type="hidden" name="_method" value="delete">
		    <button style="float: right;" type="submit">Nicht weiter teilnehmen</button>
		</form>	
	<% end %>
</div>








<script type="text/javascript">
	function validateDelete() {
		var msg = confirm("Dieses Ereignis löschen?");
		return msg;
	}

	function validateUnsubscribe() {
		var msg = confirm("An diesem Ereignis nicht mehr teilnehmen?");
		return msg;
	}
</script>


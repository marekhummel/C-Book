<!-- MAIN PAGE FOR A USER -->


<!-- List all appointments  -->
<p class="headline">Agenda</p>

<div class="container">
	<% for i in 0..(@appointments.size-1) %>
		<% hashtable = @appointments[i] %>
		<!-- Show Title and start time, anchor the title -->
		
		<!-- If this user created this event, highlight it -->
		<% c = "" %>
		<% if @user_is_creator.include?(hashtable["ID"]) then %>
			<% 	c = "mine" %>
		<% end %>

		<div class="appointment" onclick="window.location='/appointment/<%= hashtable["ID"].to_s %>'">
		    <p class="<%= c %>"><%= hashtable["Title"].to_s %></p>
		    <span><%= "Beginn: " + DateTime.iso8601(hashtable["Start"]).format! %></span>
	    </div>

	    <% if i != @appointments.size - 1 %>
			<hr>
		<% end %>
	<% end %>
</div>


<div class="newappointment" onclick="window.location='/appointment/new'" title="New">
	Neues Ereignis
</div>

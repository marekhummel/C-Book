<p>Ereignis erstellen</p>

<form action="/appointment_new" method="post">
    
    <p>Titel: <input type="text" name="title" placeholder="Titel"></p>


    <% for line in ["start", "end"] %>
    
	    <p><%= (line == "start" ? "Beginn" : "Ende") %>

	    	Monat:<select name=<%= line + "month" %>>
				<% for month in 1..12 %>
			  		<option><%= (month < 10 ? "0" : "") + month.to_s %></option>
				<% end %>
			</select>
			Tag:<select name=<%= line + "day" %>>
				<% for day in 1..31 %>
			  		<option><%= (day < 10 ? "0" : "") + day.to_s %></option>
				<% end %>
			</select> 
			Jahr:<select name=<%= line + "year" %> style="margin-right: 25px;" >
				<% for year in 2000..2030 %>
			  		<option><%= year.to_s %></option>
				<% end %>
			</select> 
			Stunde:<select name=<%= line + "hours" %>>
				<% for hour in 0..23 %>
			  		<option><%= (hour < 10 ? "0" : "") + hour.to_s %></option>
				<% end %>
			</select> 
			Minute:<select name=<%= line + "mins" %>>
				<% for min in 0..59 %>
			  		<option><%= (min < 10 ? "0" : "") + min.to_s %></option>
				<% end %>
			</select> 
			Sekunde:<select name=<%= line + "secs" %>>
				<% for sec in 0..59 %>
			  		<option><%= (sec < 10 ? "0" : "") + sec.to_s %></option>
				<% end %>
			</select> 

		</p>
	<% end %>

	<p>
		Teilnehmer: 
		<div class="contributors">
			<% for id in 0..(@otherusers.size-1) %>
				<input name=<%="cont-" + @otherusers[id]["ID"].to_s%> type="checkbox" /><%= @otherusers[id]["Name"] + " " + @otherusers[id]["Surname"] %><br />
			<% end %>
		</div>
	</p>


    <input type="submit" value="Ereignis hinzufügen">
</form>

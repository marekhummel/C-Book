<!-- COMMON LAYOUT -->

<!DOCTYPE html>
<html lang="en">

    <head>
        <title>C-Book</title>
        <meta charset="utf-8">
        
        <!-- Necessary stylesheets + font -->
        <link rel="stylesheet" type="text/css" href="/header.css">
        <link rel="stylesheet" type="text/css" href="/form.css">
        <link rel="stylesheet" type="text/css" href="/images.css">       
        <link rel="stylesheet" type="text/css" href="/container.css">    
        <link rel="stylesheet" type="text/css" href="http://fonts.googleapis.com/css?family=Lato">

        <!-- Escape does the same as clicking the "back" link -->
        <script>
            window.onkeydown = function( event ) {
                if ( event.keyCode === 27 ) {
                    window.location = '<%= @backroute %>';
                }
            };
        </script>
    </head>

    
    <body style="background-image: url('/images/background.jpeg');">

        <!-- the header with the navigation bar -->
        <header>
            <ul id="navbar">
                <!-- left element -->
                <li class="outside left">
                    <!-- Only show "back"-button if it is not refering to the current route -->
                    <% if request.path_info() != @backroute %>
                        <a href=<%= (@backroute == nil ? "/" : @backroute) %> title="Home">Zurück</a>  
                    <% end %> 
                </li>

                <!-- Center element -->
                <li class="inside">
                    <span style="white-space: nowrap;">
                        C-BOOK
                    </span>
                </li>

                <!-- center element -->
                <li class="outside right">
                    <!-- Show either login or logout anchor, if logged in show current user -->
                    <% if logged_in? then %>
                        <p style="margin: 0px 0px 5px 0px;">
                            Zurzeit angmeldet:   
                            <a href="/account"><%= get_fullname(current_user()) %></a>
                            <br>
                        </p>

                        <a href="/logout">Abmelden</a>
                    <% else %>
                        <a href="/login">Anmelden</a>
                    <% end %>
                </li>
            </ul>  
        </header>

        <!-- the main body -->
        <section style="padding-top: 40px;">
            <%= yield %>
        </section>


        <!-- Show extra anchors if an admin is logged in -->
        <% if logged_in? && is_admin?(current_user()) %>
            <footer style="margin-top: 20px; text-align: center;">
                <a href="/useroverview" title="Useroverview">All Users</a>
                <a href="/appointmentoverview" title="Overview">All Appointments</a>
            </footer>
        <% end %>
    </body>
</html>
<!-- COMMON LAYOUT -->
<!DOCTYPE html>
<html lang="en">
<head>
  <title>C-Book</title>
  <meta charset="utf-8">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1>C-Book</h1>
      <ul>
        <li><a href=<%= (@backroute == nil ? "/" : @backroute) %> title="Home">Back</a></li>
        
        <% if logged_in? then %>
          <li>
            <a href="/logout">Log Out</a> - Currently logged in: <%= current_user["Username"] %> 
          </li>
        <% end %>
      </ul>   
    <p>---------------------------------------------</p>
  </header>

  <section>
    <%= yield %>
  </section>

  <footer>
    <br /><br /><br />
    <p>---------------------------------------------</p>
    <h1>FOOTER</p>
  </footer>
</body>
</html>
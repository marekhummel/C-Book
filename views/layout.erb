<!-- COMMON LAYOUT -->

<!DOCTYPE html>
<html lang="en">
  <head>
    <title>C-Book</title>
    <meta charset="utf-8">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" type="text/css" href="http://fonts.googleapis.com/css?family=Lato">
  </head>
  <body>

    <header>
		<ul id="navbar">
		  	<li class="outside left"></li>
		  	<li class="inside">C-BOOK</li>
		  	<li class="outside right">
		  		<% if logged_in? then %>
            		<a href="/logout">Abmelden</a> - Zurzeit angmeldet: <%= current_user["Username"] %> 
        		<% else %>
        			<a href="/login">Anmelden</a>
        		<% end %>
		 	</li>
		</ul>  




      <ul>
        <li><a href=<%= (@backroute == nil ? "/" : @backroute) %> title="Home">Zurück</a></li>
      </ul>   



      <p>---------------------------------------------</p>
    </header>

    <section>
      <%= yield %>
    </section>
  </body>
</html>
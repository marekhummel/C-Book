<!-- Sign up form -->
<form class="auth" action="/signup" method="post">
    <headline>Registrieren</headline>
    <!-- Credentials -->
    <label>Benutzername</label> 
    <input type="text" name="username" autocomplete="off" class="inputusername">
    <label>Passwort</label> 
    <input type="password" name="password" autocomplete="off" oninput="validatePasswords()">
    <label>Passwort bestätigen</label> 
    <input type="password" name="confirmation" autocomplete="off" oninput="validatePasswords()"></br>


    <!-- Fullname -->
    <label style="margin-top: 20px;">Vorname</label> 
    <input style="margin-top: 20px;" type="text" name="name" autocomplete="off">
    <label>Nachname</label> 
    <input type="text" name="surname" autocomplete="off">

    <!-- Birthday -->
    <label style="margin-top: 20px;">Geburtstag</label>
    <input class="nud" style="margin-top: 20px;" name="bday_day" type="number" value="1" max="31" min="1" step="1"/>
    <input class="nud" style="margin-top: 20px;" name="bday_month" type="number" value="1" max="12" min="1" step="1"/>
    <input class="nud" style="margin-top: 20px;" name="bday_year" type="number" value="1920" max="2016" min="1920" step="1"/>

    <!-- Submit button -->
    <button type="submit">Registrieren</button>
</form>




<script type="text/javascript">
    function validatePasswords() {

        //Get all nuds (numeric up downs) on this page
        var pw = nlToArray(document.getElementsByTagName("input")).filter(function(e) {return e.getAttribute("type") == "password"});          

        
        //Get the value of the nuds
        var values = pw.map(function(p) {return p.value;});
        
        
        //Validate
        pw.forEach(function(p) {
            p.setAttribute("isvalid", (values[0] != values[1] ? "false" : "true"));
        });
    }



    //Copy the elements of the returned nodelist into an array    
    function nlToArray(nl) {
        var arr = [];                                                                          
        for (var i = nl.length; i--; arr.unshift(nl[i]));
        return arr;
    }
    
</script>
 

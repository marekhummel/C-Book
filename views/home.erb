<!-- HOMEPAGE -->


<!-- Sign up form -->
<form class="auth" action="/signup" method="post">
    <label>Benutzername</label> 
    <input type="text" name="username" required>
    <label>Passwort</label> 
    <input type="password" name="password" required>
    <label>Passwort bestätigen</label> 
    <input type="password" name="confirmation" required></br>

    <label>Vorname</label> 
    <input type="text" name="name" required>
    <label>Nachname</label> 
    <input type="text" name="surname" required>


    <label>Geburtstag</label>
    <select name="bday_day">
        <% for day in 1..31 %>
            <option><%= (day < 10 ? "0" : "") + day.to_s %></option>
        <% end %>
    </select> 
    <select name="bday_month">
        <% for month in 1..12 %>
            <option><%= (month < 10 ? "0" : "") + month.to_s %></option>
        <% end %>
    </select> 
    <select name="bday_year">
        <% for year in 1920..2016 %>
            <option><%= year.to_s %></option>
        <% end %>
    </select> 


  
    <button type="submit">Registrieren</button>
</form>
 

 

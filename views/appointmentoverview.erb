<!-- OVERVIEW OF THE APPOINTMENTS (ADMIN ONLY!) -->

<p>Appointments:</p>


<!-- Simply show all appointments in a table -->
<table>
    <tr id="head"><td>Title</td><td>Fullname</td><<td>Start</td><td>End</td></tr>

    <% for hashtable in @appointmentoverview %>
        <tr>
            <td><%= hashtable["Title"] %></td>
            <td><%= get_fullname(hashtable) %></td>
            <td><%= hashtable["Start"] %></td>
            <td><%= hashtable["End"] %></td>
        </tr>
    <% end %>
</table>


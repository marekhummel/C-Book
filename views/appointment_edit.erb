<!-- EDIT APPOINTMENT -->



<form class="app" action="/appointment_edit" method="post">
    <headline>Ereignis bearbeiten</headline>

    <label>Titel</label> 
    <input type="text" name="title" value="<%= @curr_app["Title"] %>" >


    <!-- Display of all comboboxes via a for loop -->
    <% for line in ["start", "end"] %>
        
        <!-- Write "Beginn" or "Ende" at the begin depending on the current for-loop state -->
        <label><%= (line == "start" ? "Beginn" : "Ende") %></label>

        <label>Tag</label>
        <select name=<%= line + "day" %>>
            <% for day in 1..31 %>
                <% text = (day < 10 ? "0" : "") + day.to_s %>
                
                <% if day == @times[line].Day %>
                    <option selected><%= text %></option>
                <% else %>
                    <option><%= text %></option>
                <% end %>

            <% end %>
        </select> 
        

        <label>Monat</label>
        <select name=<%= line + "month" %>>
            <% for month in 1..12 %>
                <% text = (month < 10 ? "0" : "") + month.to_s %>
                
                <% if month == @times[line].Month %>
                    <option selected><%= text %></option>
                <% else %>
                    <option><%= text %></option>
                <% end %>

            <% end %>
        </select> 

        <label>Jahr</label>
        <select name=<%= line + "year" %> style="margin-right: 25px;" >
            <% for year in 2000..2030 %>
                <% text = (year < 10 ? "0" : "") + year.to_s %>
                
                <% if year == @times[line].Year %>
                    <option selected><%= text %></option>
                <% else %>
                    <option><%= text %></option>
                <% end %>

            <% end %>
        </select> 

        <label>Stunde</label>
        <select name=<%= line + "hours" %>>
            <% for hour in 0..23 %>
                <% text = (hour < 10 ? "0" : "") + hour.to_s %>
                
                <% if hour == @times[line].Hours %>
                    <option selected><%= text %></option>
                <% else %>
                    <option><%= text %></option>
                <% end %>

            <% end %>
        </select> 

        <label>Minute</label>
        <select name=<%= line + "mins" %>>
            <% for min in 0..59 %>
                <% text = (min < 10 ? "0" : "") + min.to_s %>
                
                <% if min == @times[line].Minutes %>
                    <option selected>
                <% else %>
                    <option>
                <% end %>

                    <%= text %>
                </option>

            <% end %>
        </select> 

        <label>Sekunde</label>
        <select name=<%= line + "secs" %>>
            <% for second in 0..59 %>
                <% text = (second < 10 ? "0" : "") + second.to_s %>
                
                <% if second == @times[line].Seconds %>
                    <option selected><%= text %></option>
                <% else %>
                    <option><%= text %></option>
                <% end %>

            <% end %>
        </select> 
    <% end %>






    <!-- List all contributors -->
    <p>
        Teilnehmer: 
        <div class="contributors">
            <% for user in @otherusers %>
                <% name = "cont-" + user["ID"].to_s%>

                <% if @contributors.any? { |u| u["ID"] == user["ID"]} %>
                    <input name=<%= name %> type="checkbox" checked/>
                <% else %>
                    <input name=<%= name %> type="checkbox" />
                <% end %>

                <%= get_fullname(user) %><br />
            <% end %>
        </div>
    </p>

    <!-- Extra variables to be posted -->
    <input type="hidden" name="id" value=<%= @appid %>>
    <input type="hidden" name="_method" value="put">

    <!--  Submit button -->
    <input type="submit" value="Speichern">
</form>

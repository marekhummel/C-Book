<!-- EDIT APPOINTMENT -->

<p>Ereignis bearbeiten</p>

<form action="/appointment_edit" method="post">
    
    <p>Titel: <input type="text" name="title" value="<%= @curr_app["Title"] %>" > </p>

    <!-- Display of all comboboxes via a for loop -->
    <% for line in ["start", "end"] %>
        
        <!-- Write "Beginn" or "Ende" at the begin depending on the current for-loop state -->
        <p><%= (line == "start" ? "Beginn" : "Ende") %></p>

        Tag:
        <select name=<%= line + "day" %>>
            <% for day in 1..31 %>
                <option><%= (day < 10 ? "0" : "") + day.to_s %></option>
            <% end %>
        </select> 

        Monat:
        <select name=<%= line + "month" %>>
            <% for month in 1..12 %>
                <option><%= (month < 10 ? "0" : "") + month.to_s %></option>
            <% end %>
        </select>

        Jahr:
        <select name=<%= line + "year" %> style="margin-right: 25px;" >
            <% for year in 2000..2030 %>
                <option><%= year.to_s %></option>
            <% end %>
        </select> 

         Stunde:
        <select name=<%= line + "hours" %>>
            <% for hour in 0..23 %>
                <option><%= (hour < 10 ? "0" : "") + hour.to_s %></option>
            <% end %>
        </select> 

        Minute:
        <select name=<%= line + "mins" %>>
            <% for min in 0..59 %>
                <option><%= (min < 10 ? "0" : "") + min.to_s %></option>
            <% end %>
        </select> 

        Sekunde:
        <select name=<%= line + "secs" %>>
            <% for sec in 0..59 %>
                <option><%= (sec < 10 ? "0" : "") + sec.to_s %></option>
            <% end %>
        </select> 
    <% end %>

    <!-- List all contributors -->
    <p>
        Teilnehmer: 
        <div class="contributors">
            <% for id in 0..(@otherusers.size-1) %>
                <% name = "cont-" + @otherusers[id]["ID"].to_s%>
                <input name=<%= name %> type="checkbox" /><%= get_fullname(@otherusers[id]) %><br />
            <% end %>
        </div>
    </p>

    <!-- Extra variables to be posted -->
    <input type="hidden" name="id" value=<%= @appid %>>
    <input type="hidden" name="_method" value="put">

    <!--  Submit button -->
    <input type="submit" value="Ereignis bearbeiten">
</form>

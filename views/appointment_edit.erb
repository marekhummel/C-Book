<!-- EDIT APPOINTMENT -->

<form class="app" action="/appointment_edit" method="post">
    <headline>Ereignis bearbeiten</headline>

    <label>Titel</label> 
    <input type="text" name="title" value="<%= @curr_app["Title"] %>" >


    <label style="margin-top: 20px;">Beginn</label>
    <input style="margin-top: 20px;" class="nud" name="startday" type="number" value="<%= @starttime.Day %>" max="31" min="1" step="1"/>
    <input style="margin-top: 20px;" class="nud" name="startmonth" type="number" value="<%= @starttime.Month %>" max="12" min="1" step="1"/>
    <input style="margin-top: 20px;" class="nud" name="startyear" type="number" value="<%= @starttime.Year %>" max="2050" min="1950" step="1"/>
    <input style="margin-top: 20px;" class="nud" name="starthours" type="number" value="<%= @starttime.Hours %>" max="23" min="0" step="1"/>
    <input style="margin-top: 20px;" class="nud" name="startmins" type="number" value="<%= @starttime.Minutes %>" max="59" min="0" step="1"/>

    <label>Ende</label>
    <input class="nud" name="endday" type="number" value="<%= @endtime.Day %>" max="31" min="1" step="1"/>
    <input class="nud" name="endmonth" type="number" value="<%= @endtime.Month %>" max="12" min="1" step="1"/>
    <input class="nud" name="endyear" type="number" value="<%= @endtime.Year %>" max="2050" min="1950" step="1"/>
    <input class="nud" name="endhours" type="number" value="<%= @endtime.Hours %>" max="23" min="0" step="1"/>
    <input class="nud" name="endmins" type="number" value="<%= @endtime.Minutes %>" max="59" min="0" step="1"/>






    <!-- List all contributors -->
    <label style="margin-top: 20px;">Teilnehmer</label>
    <div class="contributors">
        <% for user in @otherusers %>
            <% name = "cont-" + user["ID"].to_s%>

            <% if @contributors.any? { |u| u["ID"] == user["ID"]} %>
                <input class="cb" name=<%= name %> type="checkbox" checked/>
            <% else %>
                <input class="cb" name=<%= name %> type="checkbox" />
            <% end %>

            <span><%= get_fullname(user) %></span><br />
        <% end %>
    </div>

    <!-- Extra variables to be posted -->
    <input type="hidden" name="id" value=<%= @appid %>>
    <input type="hidden" name="_method" value="put">

    <!--  Submit button -->
    <button type="submit">Speichern</button>
</form>

<!-- OVERVIEW OF THE USERS -->


<!-- Simply show all appointments in a table -->
<p>Users:</p>
<table>
    <tr><td>ID</td><td>Username</td><td>PWHash</td><td>Fullname</td><td>DateOfBirth</td></tr>

    <% for user in @useroverview %>
        <tr>
            <td><%= user["ID"] %></td>
            <td><%= user["Username"] %></td>
            <td><%= user["PWHash"] %></td>
            <td><%= get_fullname(user) %></td>
            <td><%= user["DateOfBirth"] %></td>
        </tr>
    <% end %>
</table>
